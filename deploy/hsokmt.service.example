[Unit]
Description=HSOKMT Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hsokmt
User=hsokmt
Group=hsokmt
EnvironmentFile=-/etc/hsokmt/hsokmt.env
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/hsokmt/target/hsokmt-0.0.1-SNAPSHOT-jar-with-dependencies.jar
Restart=always
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
